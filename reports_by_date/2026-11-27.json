    "parsed": {
      "report_date": "2026-11-27",
      "title": "ClickFix: Fake Cloudflare Verification on a School Portal Spreads New Olympic 0.1.0 RAT",
      "summary": "A campaign uses a fake Cloudflare CAPTCHA page hosted on a subdomain tied to an Italian school to trick users into running a PowerShell command, a technique known as ClickFix. The command downloads and runs a payload that starts a multi-stage loader chain, which ultimately deploys Olympic 0.1.0, a modular remote access trojan for Windows x64 systems. Olympic communicates with its command-and-control server over WebSocket, can load additional modules in memory, and offers remote desktop, remote terminal, file transfer, process management, clipboard access, and input logging. The campaign requires no administrative privileges, and its goal is persistent remote access to compromised systems. CERT-AGID reports this as the first observation of Olympic and named it accordingly, since public sources did not link it to a known family.",
      "completeness": "High",
      "threats": [
        "Clickfix_technique",
        "Olympic_rat",
        "Donut"
      ],
      "geo": [
        "Italian"
      ],
