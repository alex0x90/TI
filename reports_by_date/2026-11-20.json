    "parsed": {
      "report_date": "2026-11-20",
      "title": "Fake GTA VI PC client spreads malware through a ClickFix attack",
      "summary": "A fake GTA VI PC streaming client website lures Windows users with a ClickFix command that tells them to press Win+R, paste a PowerShell command and run it. The command downloads and runs a script that fetches a ZIP archive, which leads to a sideloaded DLL that injects a Rust-based information stealer into legitimate Windows processes. The stealer targets browser credentials and cookies, Discord, Steam and cryptocurrency wallet data, and AI and developer service credentials. Because the game is not available on PC, the attackers pose as a client for streaming it from an Xbox or PlayStation console. Bitdefender Total Security's Advanced Threat Defense detected the threat, and anyone who ran the command should treat the computer as compromised and change important passwords from a clean device.",
      "completeness": "Medium",
      "threats": [
        "Clickfix_technique",
        "Dll_sideloading_technique",
        "Process_injection_technique"
      ],
      "ttp_tactics": 1,
      "ttp_techniques": 0,
      "software": [
        "Windows Explorer",
        "Chromium",
        "Discord",
        "Steam"
      ],
      "algorithms": [
        "chacha20-poly1305",
        "zip",
        "xor"
      ],
      "functions": [
